<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PreLaunchCommand>export LD_LIBRARY_PATH=$(RemoteProjectDir)/libs/debug:$(RemoteProjectDir)/runtime/python/lib:$LD_LIBRARY_PATH</PreLaunchCommand>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <PreLaunchCommand>export LD_LIBRARY_PATH=$(RemoteProjectDir)/libs/release:$(RemoteProjectDir)/runtime/python/lib:$LD_LIBRARY_PATH</PreLaunchCommand>
  </PropertyGroup>
</Project>
